/*
  # Force HTTPS and prevent downgrade attacks
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Block your site from being embedded in iframes (clickjacking / ad injection)
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

  # Prevent MIME-type sniffing (stops scripts disguised as images)
  X-Content-Type-Options: nosniff

  # Only send referrer on same-origin requests
  Referrer-Policy: strict-origin-when-cross-origin

  # Lock down browser features not needed by a sports scoreboard
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Content Security Policy — blocks unauthorized scripts, iframes, and ad networks
  # Allows: self, Next.js inline scripts, no external JS except trusted CDNs
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

  # Cross-origin isolation
  X-DNS-Prefetch-Control: off
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
